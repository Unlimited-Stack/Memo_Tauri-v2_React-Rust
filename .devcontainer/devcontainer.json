{
  "name": "Tauri v2 Dev Environment",
  "build": { "dockerfile": "../ai-memo/Dockerfile" },
  "postCreateCommand": "cd ai-memo && npm ci && cd src-tauri && cargo check || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [1420],
  "remoteUser": "vscode"
}